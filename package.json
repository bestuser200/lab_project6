{
  "name": "parking-lab6-ci",
  "version": "1.0.0",
  "description": "ЛР6: CI/CD для unit, API(BDD) и UI тестов парковки",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "npm run test:all",
    "test:unit": "jest --runInBand",
    "test:api": "cucumber-js",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:report": "playwright show-report",
    "test:all": "npm run test:unit && npm run test:api && npm run test:ui"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.49.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "wait-on": "^8.0.1"
  }
}
